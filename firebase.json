{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/store/**",
        "destination": "/store/index.html"
      },
      {
        "source": "/idor/**",
        "destination": "/idor/index.html"
      }
    ]
  }
}
